FROM php:8.4-cli-alpine

# Instalar dependencias del sistema y herramientas de compilación
RUN apk add --no-cache \
    postgresql-dev \
    libpng-dev \
    libjpeg-turbo-dev \
    freetype-dev \
    libzip-dev \
    zip \
    unzip \
    git \
    curl \
    oniguruma-dev \
    icu-dev \
    $PHPIZE_DEPS

# Instalar extensiones de PHP requeridas por Laravel + PostgreSQL
RUN docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install \
        pdo \
        pdo_pgsql \
        bcmath \
        zip \
        gd \
        mbstring \
        intl

# Copiar ejecutable oficial de Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html
COPY . .

# Instalar dependencias de Composer ignorando la verificación estricta de versión si es necesario
RUN composer install --no-dev --optimize-autoloader --no-interaction --prefer-dist --ignore-platform-req=php+

EXPOSE 8080

CMD php artisan migrate --force --seed && php artisan config:clear && php artisan cache:clear && php artisan route:clear && php artisan config:publish cors && php artisan serve --host=0.0.0.0 --port=${PORT:-8080}
